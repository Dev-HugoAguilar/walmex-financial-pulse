# Normaliza los finales de línea a LF en el repositorio y respeta los binarios.
* text=auto eol=lf

*.md    text eol=lf
*.py    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.csv   text eol=lf

*.jpg   binary
*.png   binary
*.ico   binary
*.joblib binary
*.gz    binary
*.zip   binary
